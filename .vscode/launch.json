{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LCC: Debug CPP (C -> preprocessed C)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-ubuntu24/lcc-build/cpp",
      "args": [
        "-I${workspaceFolder}/build-ubuntu24/lcc-build/include",
        "${workspaceFolder}/hello.c",
        "${workspaceFolder}/hello.i"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },

    {
      "name": "LCC: Debug RCC (preprocessed C -> assembly)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-ubuntu24/lcc-build/rcc",
      "args": [
        "-target=x86/nasm",
        "-g",
        "${workspaceFolder}/hello.i",
        "${workspaceFolder}/hello.s"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },

    {
      "name": "LCC: Run NASM (Assembling: assembly -> object)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/nasm",
      "args": [
        "-f",
        "elf32",
        "${workspaceFolder}/hello.s",
        "-o",
        "${workspaceFolder}/hello.o"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },

    {
      "name": "LCC: Run GCC (Linking: object -> executable)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/gcc",
      "args": [
        "-m32",
        "${workspaceFolder}/hello.o",
        "-o",
        "${workspaceFolder}/hello"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
